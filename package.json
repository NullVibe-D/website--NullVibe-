{
  "name": "nullvibe-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test:server": "node --test tests/server*.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "check:launch": "node --env-file-if-exists=.env.local scripts/check-launch.mjs",
    "preview:production": "node --env-file-if-exists=.env.local scripts/preview-production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
