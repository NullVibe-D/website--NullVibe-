# Public values are included in the browser build. Never put secrets in VITE_*.
VITE_CONTACT_EMAIL=contact@nullvibe.tech
VITE_BOOKING_URL=

# Canonical website origin, required for live same-origin enquiry submissions.
# Use your final HTTPS URL without a path, e.g. https://www.your-domain.com.
PUBLIC_SITE_URL=https://nullvibe.tech

# Server-only email configuration. CONTACT_FROM_EMAIL must use a verified
# sending domain in Resend. Use plain email addresses, without display names.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@nullvibe.tech
CONTACT_FROM_EMAIL=

# Portable production server. Set HOST=0.0.0.0 for a container or hosted process.
HOST=127.0.0.1
PORT=4175

# Enable only behind ONE trusted reverse proxy that replaces X-Forwarded-For.
# Leave disabled for direct local access. Shared/multi-instance production
# deployments should enforce a global rate limit at the proxy or edge.
TRUST_PROXY=0
